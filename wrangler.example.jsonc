{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "drum-tabs",
    "main": "cloud/worker.ts",
    "compatibility_date": "2026-07-30",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "drum-tabs",
            "database_id": "REPLACE_WITH_D1_DATABASE_ID",
            "migrations_dir": "cloud/migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "TABS_BUCKET",
            "bucket_name": "drum-tabs"
        }
    ],
    "vars": {
        "APP_ORIGIN": "https://REPLACE_WITH_YOUR_DOMAIN",
        "MYTABS_DISABLE_SIGN_UP": "false"
    },
    "triggers": {
        "crons": ["0 3 * * *"]
    }
}
